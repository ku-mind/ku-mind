# KU Mind root environment file
# Copy this file to .env at the project root:
# cp .env.example .env

# App
APP_NAME=KU Mind API
JWT_SECRET_KEY=change-this-secret-in-production
JWT_EXPIRE_MINUTES=1440

# Gemini
# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Database
# Default local development uses SQLite. Leave DATABASE_URL as SQLite if you do not need Docker/Postgres.
DATABASE_URL=sqlite:///./ku_mind.db

# Optional Postgres settings for docker-compose.
# If backend runs inside docker-compose, use host "db":
# DATABASE_URL=postgresql+psycopg://kumind:kumind@db:5432/kumind
#
# If backend runs on your machine and Postgres runs in Docker, use host "localhost":
# DATABASE_URL=postgresql+psycopg://kumind:kumind@localhost:5432/kumind
POSTGRES_USER=kumind
POSTGRES_PASSWORD=kumind
POSTGRES_DB=kumind

# Frontend
# Usually not required because Vite dev server proxies /api to backend.
# VITE_API_URL=http://127.0.0.1:8000
